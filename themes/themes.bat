if not defined THEME set "THEME=acid"

if /i "%THEME%"=="acid"       goto :acid
if /i "%THEME%"=="dracula"    goto :dracula
if /i "%THEME%"=="nord"       goto :nord
if /i "%THEME%"=="monokai"    goto :monokai
if /i "%THEME%"=="catppuccin" goto :catppuccin
if /i "%THEME%"=="murphy"     goto :murphy
