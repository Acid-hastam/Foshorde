{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foshorde",
  "version": "1.4.0",
  "identifier": "com.amir.foshorde",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Foshorde",
        "width": 640,
        "height": 440,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
